{
  "name": "sillon",
  "private": true,
  "description": "Sillon — plateforme de découverte et de partage musical",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@sillon/config": "workspace:*",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  }
}
