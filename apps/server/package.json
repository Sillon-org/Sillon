{
  "name": "@sillon/server",
  "version": "0.0.0",
  "private": true,
  "description": "API REST de Sillon (NestJS)",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.1",
    "@nestjs/platform-express": "^12.4.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sillon/shared-types": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.1",
    "@sillon/config": "workspace:*",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.39.5",
    "prisma": "^7.10.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
